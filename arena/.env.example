# Copy to .env (docker compose) or /etc/pokerth-arena.env (install.sh).
# The super admin's master key: a long random secret.
ARENA_ADMIN_TOKEN=
# Behind a reverse proxy: the player's address from X-Forwarded-For.
ARENA_TRUST_PROXY=0
# The Arena's public address (pictures of shared links), e.g. https://arena.example.org
ARENA_PUBLIC_URL=
# Optional: a fixed link key (else made once, shown on /arena/organize › Web client).
# ARENA_LINK_KEY=

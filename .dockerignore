# Keep the build context small and, crucially, prevent `COPY . .` from
# clobbering the production node_modules installed during the image build.

node_modules
npm-debug.log*

.git
.gitignore
.dockerignore

# Local runtime config / state (never bake these into the image): a checkout
# that has run bare-metal holds secrets here (db-config.json, scoped-tokens.json,
# admin-config.json).
.env
.env.example
stats.json
stats.meta.json
admin-config.json
admin-audit.json
deploy-history.json
scoped-tokens.json
db-config.json
visits.json
polls.json
broadcasts.json
lan-boards.json
wec-finals.json
monthly-cups.json
prefs
*.json.tmp
*.json.corrupt-*

# Dev-only / docs (not needed at runtime). scripts/ itself IS needed: the
# admin panel spawns scripts/*-manifest.mjs when importing deck/theme/table
# packs — only the test suites are dev-only.
docs
scripts/test-*.mjs
scripts/build-proto.mjs
install.sh
README.md

# These describe how to build/run; not needed inside the image
Dockerfile
docker-compose.yml

# Data left by the Arena that ran inside the web client until web.326
arena-data
arena
